{
  "name": "lexi",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "test": "vitest",
    "get-android-version": "node scripts/get-android-version.js",
    "sync-android-version": "node scripts/sync-android-version.js",
    "update-android": "npm run build && npx cap sync android && npm run sync-android-version",
    "build-debug-apk": "cd android && .\\gradlew.bat assembleDebug",
    "upload-release": "node scripts/upload-release.js",
    "release": "npm run update-android && npm run build-debug-apk && npm run upload-release",
    "android:icons": "node scripts/generate-icons.js && npx capacitor-assets generate --android --iconBackgroundColor \"#0F8B77\" --splashBackgroundColor \"#F6F4EF\" --splashBackgroundColorDark \"#12161C\""
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.47.10",
    "lucide-vue-next": "^0.563.0",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "sass": "^1.83.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  }
}
